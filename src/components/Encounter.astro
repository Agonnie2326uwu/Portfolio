---
---

<div id="encounter" class="encounter-overlay">
  <div class="encounter-stripes">
    <div class="stripe"></div><div class="stripe"></div><div class="stripe"></div>
    <div class="stripe"></div><div class="stripe"></div><div class="stripe"></div>
    <div class="stripe"></div><div class="stripe"></div><div class="stripe"></div>
    <div class="stripe"></div><div class="stripe"></div><div class="stripe"></div>
  </div>
  <div class="encounter-flash"></div>
  <div class="battle-screen">
    <div class="battle-scene">
      <!-- Enemy info bar (top left) -->
      <div class="enemy-bar">
        <div class="pokemon-name-tag">
          <span class="pokemon-name">CARL</span>
          <span class="pokemon-level">Lv.23</span>
        </div>
        <div class="hp-bar-row">
          <span class="hp-label">HP</span>
          <div class="hp-bar"><div class="hp-fill"></div></div>
        </div>
      </div>

      <!-- Enemy sprite (top right) -->
      <div class="enemy-sprite-area">
        <div class="enemy-platform">
          <img src="/Me.png" alt="Carl" class="enemy-sprite" />
        </div>
      </div>

      <!-- Text box (bottom) -->
      <div class="battle-text-box">
        <div class="battle-text-left">
          <p class="battle-dialog">What will</p>
          <p class="battle-dialog">YOU do?</p>
        </div>
        <div class="battle-menu">
          <a href="#about" class="battle-menu-btn" id="encounter-about">ABOUT ME</a>
          <a href="#projects" class="battle-menu-btn" id="encounter-work">VIEW MY WORK</a>
          <a href="#contact" class="battle-menu-btn" id="encounter-touch">GET IN TOUCH</a>
          <a href="#" class="battle-menu-btn" id="encounter-run">PROJECTS</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .encounter-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.6s ease;
  }

  .encounter-overlay.dismiss {
    opacity: 0;
    pointer-events: none;
  }

  /* Stripe transition */
  .encounter-stripes {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    z-index: 1;
  }

  .stripe {
    flex: 1;
    background: #000;
    border-bottom: 2px solid #fff;
    transform: scaleX(0);
    transform-origin: left;
    animation: stripeWipe 0.12s ease forwards;
  }

  .stripe:nth-child(1) { animation-delay: 0.05s; }
  .stripe:nth-child(2) { animation-delay: 0.07s; }
  .stripe:nth-child(3) { animation-delay: 0.09s; }
  .stripe:nth-child(4) { animation-delay: 0.11s; }
  .stripe:nth-child(5) { animation-delay: 0.13s; }
  .stripe:nth-child(6) { animation-delay: 0.15s; }
  .stripe:nth-child(7) { animation-delay: 0.17s; }
  .stripe:nth-child(8) { animation-delay: 0.19s; }
  .stripe:nth-child(9) { animation-delay: 0.21s; }
  .stripe:nth-child(10) { animation-delay: 0.23s; }
  .stripe:nth-child(11) { animation-delay: 0.25s; }
  .stripe:nth-child(12) { animation-delay: 0.27s; }

  .encounter-flash {
    position: absolute;
    inset: 0;
    background: #fff;
    z-index: 2;
    opacity: 0;
    animation: flash 0.12s ease 0.5s;
  }

  /* Battle screen */
  .battle-screen {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 0.4s ease 0.7s forwards;
  }

  .battle-scene {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: url('/pokemon-battle-bg.png') center center / cover no-repeat;
    position: relative;
    overflow: hidden;
  }

  /* Enemy info bar (beside sprite) */
  .enemy-bar {
    position: absolute;
    top: 130px;
    right: 520px;
    z-index: 5;
    background: #fff;
    border: 4px solid #000;
    box-shadow: 4px 4px 0 #000;
    padding: 18px 28px;
    width: 400px;
    box-sizing: border-box;
  }

  .pokemon-name-tag {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .pokemon-name {
    font-family: 'Press Start 2P', monospace;
    font-size: 1.4rem;
    color: #000;
  }

  .pokemon-level {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.9rem;
    color: #444;
  }

  .hp-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp-label {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.8rem;
    color: #e74c3c;
  }

  .hp-bar {
    flex: 1;
    height: 16px;
    background: #555;
    border: 3px solid #000;
    box-shadow: 2px 2px 0 #000;
    overflow: hidden;
  }

  .hp-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #7ec850, #4a9f2a);
  }

  /* Enemy sprite area */
  .enemy-sprite-area {
    position: absolute;
    top: 260px;
    right: 160px;
    z-index: 4;
  }

  .enemy-platform {
    width: 300px;
    height: 85px;
    background: linear-gradient(180deg, #6abf6a, #4a9f4a);
    border-radius: 50%;
    border: 4px solid #3a7f3a;
    box-shadow: 4px 4px 0 #2a6f2a;
    position: relative;
  }

  .enemy-sprite {
    width: 240px;
    height: 240px;
    object-fit: cover;
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 50%;
    border: none;
    box-shadow: none;
    background: #fff;
    animation: spriteWobble 2s ease-in-out infinite;
    transform-origin: bottom center;
  }

  /* Text box (bottom) */
  .battle-text-box {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 5;
    background: #fff;
    border: 4px solid #000;
    box-shadow: 0 -4px 0 #000;
    margin: 0 12px 12px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .battle-text-left {
    flex-shrink: 0;
  }

  .battle-dialog {
    font-family: 'Press Start 2P', monospace;
    font-size: 1rem;
    color: #000;
    line-height: 1.8;
  }

  .battle-menu {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    min-width: 300px;
  }

  .battle-menu-btn {
    display: block;
    padding: 12px 16px;
    border: 4px solid #000;
    box-shadow: 4px 4px 0 #000;
    background: #f0f0f0;
    color: #000;
    font-family: 'Press Start 2P', monospace;
    font-size: 0.6rem;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: background 0.1s, color 0.1s, transform 0.1s, box-shadow 0.1s;
  }

  .battle-menu-btn:hover {
    background: #000;
    color: #fff;
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #000;
  }

  @keyframes stripeWipe {
    to { transform: scaleX(1); }
  }

  @keyframes flash {
    0% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  @keyframes spriteWobble {
    0%, 100% { transform: translateX(-50%) rotate(-3deg); }
    50% { transform: translateX(-50%) rotate(3deg); }
  }

  @media (max-width: 768px) {
    .enemy-bar {
      top: 20px;
      right: 20px;
      left: 20px;
      width: auto;
      padding: 12px 16px;
    }

    .pokemon-name {
      font-size: 0.9rem;
    }

    .pokemon-level {
      font-size: 0.6rem;
    }

    .hp-label {
      font-size: 0.5rem;
    }

    .hp-bar {
      height: 10px;
    }

    .enemy-sprite-area {
      top: 160px;
      right: 50%;
      transform: translateX(50%);
    }

    .enemy-platform {
      width: 160px;
      height: 50px;
    }

    .enemy-sprite {
      width: 140px;
      height: 140px;
      bottom: 20px;
    }

    .battle-text-box {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px 14px;
      margin: 0 8px 8px;
    }

    .battle-text-left {
      text-align: center;
    }

    .battle-dialog {
      font-size: 0.7rem;
    }

    .battle-menu {
      min-width: unset;
      gap: 8px;
    }

    .battle-menu-btn {
      padding: 10px 8px;
      font-size: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .enemy-bar {
      top: 12px;
      padding: 10px 12px;
    }

    .pokemon-name {
      font-size: 0.7rem;
    }

    .pokemon-level {
      font-size: 0.5rem;
    }

    .hp-bar {
      height: 8px;
    }

    .enemy-sprite-area {
      top: 130px;
    }

    .enemy-platform {
      width: 120px;
      height: 40px;
    }

    .enemy-sprite {
      width: 110px;
      height: 110px;
      bottom: 15px;
    }

    .battle-dialog {
      font-size: 0.6rem;
    }

    .battle-menu-btn {
      padding: 8px 6px;
      font-size: 0.45rem;
    }
  }
</style>

<script>
  const encounter = document.getElementById('encounter');
  const aboutBtn = document.getElementById('encounter-about');
  const workBtn = document.getElementById('encounter-work');
  const touchBtn = document.getElementById('encounter-touch');
  const runBtn = document.getElementById('encounter-run');

  function dismissEncounter(e) {
    if (e) e.preventDefault();
    encounter.classList.add('dismiss');
    setTimeout(() => {
      encounter.style.display = 'none';
    }, 600);
  }

  aboutBtn.addEventListener('click', (e) => {
    dismissEncounter(e);
    setTimeout(() => {
      document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
    }, 600);
  });

  workBtn.addEventListener('click', (e) => {
    dismissEncounter(e);
    setTimeout(() => {
      document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth' });
    }, 600);
  });

  touchBtn.addEventListener('click', (e) => {
    dismissEncounter(e);
    setTimeout(() => {
      document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
    }, 600);
  });

  runBtn.addEventListener('click', (e) => {
    dismissEncounter(e);
  });
</script>
